rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      // Check for custom claim or a more secure admin verification
      return request.auth.token.admin == true;
    }

    // Helper to check if user is a member of a project
    function isProjectMember(appId, projectId) {
      return exists(/databases/$(database)/documents/artifacts/$(appId)/public/data/projects/$(projectId)/members/$(request.auth.uid));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId; 
    }

    match /licenseKeys/{keyId} {
        allow read, list, create, delete: if isAuthenticated() && isAdmin();
        
        allow get: if isAuthenticated(); 
        allow update: if isAuthenticated() 
                      && resource.data.isUsed == false 
                      && request.resource.data.isUsed == true
                      && request.resource.data.usedBy == request.auth.uid
                      && request.resource.data.usedAt == request.time;
    }

    match /artifacts/{appId}/users/{userId}/{document=**} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isOwner(userId);
    }
    
    match /artifacts/{appId}/public/data/projects/{projectId} {
       allow read: if isAuthenticated();
       allow create: if isAuthenticated();
       allow update: if isAuthenticated() && (resource.data.owner == request.auth.uid || isProjectMember(appId, projectId) || isAdmin());
       allow delete: if isAuthenticated() && (resource.data.owner == request.auth.uid || isAdmin());

       match /members/{memberId} {
         allow read: if isAuthenticated();
         allow write: if isAuthenticated() && (get(/databases/$(database)/documents/artifacts/$(appId)/public/data/projects/$(projectId)).data.owner == request.auth.uid || isAdmin());
       }
    }

    match /artifacts/{appId}/public/data/{collectionName}/{document=**} {
      // Check membership for any test cases, modules, etc.
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (isProjectMember(appId, request.resource.data.projectId) || isAdmin());
    }
    
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
